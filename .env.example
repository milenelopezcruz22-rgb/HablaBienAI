# Copia este archivo como .env y completa tus claves reales

# Groq API
GROQ_API_KEY=tu_clave_de_groq_aqui

# Google Gemini API
GEMINI_API_KEY=tu_clave_de_gemini_aqui
# Groq API - Transcripción y análisis de voz
GROQ_API_KEY=tu_key_real_aqui

# Google - Gemini API (análisis multimodal)
GEMINI_API_KEY=tu_key_real_aqui

# Base de datos PostgreSQL
DATABASE_URL=postgresql://user:pass@localhost:5432/habla_bien

# Backend
BACKEND_PORT=8000
SECRET_KEY=tu_secret_key_aqui

# Frontend
VITE_API_URL=http://localhost:8000

