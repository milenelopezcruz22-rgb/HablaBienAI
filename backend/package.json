{
  "name": "hablabien-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "concurrently --names \"EXPRESS,FASTAPI\" --prefix-colors \"blue,green\" \"node server.js\" \"python -m uvicorn app.main:app --host 0.0.0.0 --port 8000\"",
    "start:fastapi": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
